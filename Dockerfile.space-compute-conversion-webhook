FROM golang:1.27.1-bookworm AS build
WORKDIR /src
COPY . .
ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -buildvcs=false -trimpath -ldflags='-s -w' \
    -o /out/space-compute-conversion-webhook ./cmd/space-compute-conversion-webhook

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/space-compute-conversion-webhook /usr/local/bin/space-compute-conversion-webhook
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/space-compute-conversion-webhook"]
